# Verify that statement_timeout interrupts long tokenization cleanly and leaves
# the backend and cached tokenizer usable afterward. Deterministic per-token and
# per-chunk interrupt check counts are asserted in Rust unit tests.

statement ok
BEGIN;

statement ok
SET LOCAL pg_tokenizer.max_input_bytes = 32000000;

statement ok
SET LOCAL pg_tokenizer.max_output_tokens = 3000000;

statement ok
SET LOCAL pg_tokenizer.max_output_bytes = 256000000;

statement ok
SELECT tokenizer_catalog.create_text_analyzer('interrupt_words', 'pre_tokenizer = "unicode_segmentation"');

statement ok
SELECT tokenizer_catalog.create_tokenizer('interrupt_bert', $$
text_analyzer = "interrupt_words"
model = "bert_base_uncased"
$$);

# Warm the cached model before setting statement_timeout.
query T
SELECT tokenizer_catalog.tokenize('hello', 'interrupt_bert');
----
{7592}

statement ok
SAVEPOINT before_timeout;

statement ok
SET LOCAL statement_timeout = '100ms';

statement error canceling statement due to statement timeout
SELECT tokenizer_catalog.tokenize(repeat('supernovae bookings ', 1000000), 'interrupt_bert');

statement ok
ROLLBACK TO SAVEPOINT before_timeout;

statement ok
SET LOCAL statement_timeout = 0;

query T
SELECT tokenizer_catalog.tokenize('hello', 'interrupt_bert');
----
{7592}

statement ok
ROLLBACK;
