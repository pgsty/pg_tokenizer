# Configuration errors are PostgreSQL errors with SQLSTATE 22023 and the
# parser's message as DETAIL, not Rust panics; missing custom models warn.

statement ok
BEGIN;

statement ok
CREATE FUNCTION pg_temp.error_of(query text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE
    state text;
    message text;
    detail text;
BEGIN
    EXECUTE query;
    RETURN 'no error';
EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS state = RETURNED_SQLSTATE, message = MESSAGE_TEXT, detail = PG_EXCEPTION_DETAIL;
    RETURN state || ' ' || message || CASE WHEN detail <> '' THEN ' +detail' ELSE '' END;
END $$;

query T
SELECT pg_temp.error_of($q$SELECT tokenizer_catalog.create_text_analyzer('bad_toml', 'pre_tokenizer = ')$q$);
----
22023 invalid configuration for text analyzer "bad_toml" +detail

query T
SELECT pg_temp.error_of($q$SELECT tokenizer_catalog.create_text_analyzer('bad_key', 'unknown_key = 1')$q$);
----
22023 invalid configuration for text analyzer "bad_key" +detail

query T
SELECT pg_temp.error_of($q$SELECT tokenizer_catalog.create_text_analyzer('bad_regex', 'pre_tokenizer = { regex = "(" }')$q$);
----
22023 invalid regular expression in regex pre_tokenizer +detail

query T
SELECT pg_temp.error_of($q$SELECT tokenizer_catalog.create_text_analyzer('bad_ngram', $c$
[[token_filters]]
ngram = { min_gram = 3, max_gram = 2 }
$c$)$q$);
----
22023 invalid ngram token filter configuration +detail

