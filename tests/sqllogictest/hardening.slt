# A missing custom model warns, like the other drop functions, and leaves
# tokenizers alone.
statement ok
SELECT tokenizer_catalog.create_tokenizer('kept_tokenizer', 'model = "bert_base_uncased"');

query T
SELECT pg_temp.error_of($q$SELECT tokenizer_catalog.drop_custom_model('missing_model')$q$);
----
no error

query T
SELECT tokenizer_catalog.tokenize('hello', 'kept_tokenizer');
----
{7592}

# Hugging Face imports reject token IDs that do not fit in INT.
query T
SELECT pg_temp.error_of($q$SELECT tokenizer_catalog.create_huggingface_model('hf_max',
'{"model": {"type": "WordLevel", "vocab": {"[UNK]": 0, "max": 2147483647}, "unk_token": "[UNK]"}}')$q$);
----
no error

statement ok
SELECT tokenizer_catalog.create_tokenizer('hf_max', 'model = "hf_max"');

query T
SELECT tokenizer_catalog.tokenize('max', 'hf_max');
----
{2147483647}

query T
