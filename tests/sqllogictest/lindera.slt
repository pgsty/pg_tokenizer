# need lindera-ipadic flag

statement ok
BEGIN;

statement ok
SELECT tokenizer_catalog.create_lindera_model('lindera_ipadic', $$
[segmenter]
mode = "normal"
dictionary = "embedded://ipadic"
[[character_filters]]
kind = "unicode_normalize"
  [character_filters.args]
  kind = "nfkc"
[[character_filters]]
kind = "japanese_iteration_mark"
  [character_filters.args]
  normalize_kanji = true
  normalize_kana = true
[[character_filters]]
kind = "mapping"
[character_filters.args.mapping]
"リンデラ" = "Lindera"
[[token_filters]]
kind = "japanese_compound_word"
  [token_filters.args]
  kind = "ipadic"
  tags = [ "名詞,数", "名詞,接尾,助数詞" ]
  new_tag = "名詞,数"
[[token_filters]]
kind = "japanese_number"
  [token_filters.args]
  tags = [ "名詞,数" ]
[[token_filters]]
kind = "japanese_stop_tags"
  [token_filters.args]
  tags = [
  "接続詞",
  "助詞",
  "助詞,格助詞",
  "助詞,格助詞,一般",
  "助詞,格助詞,引用",
  "助詞,格助詞,連語",
  "助詞,係助詞",
  "助詞,副助詞",
  "助詞,間投助詞",
  "助詞,並立助詞",
  "助詞,終助詞",
  "助詞,副助詞／並立助詞／終助詞",
  "助詞,連体化",
  "助詞,副詞化",
  "助詞,特殊",
  "助動詞",
  "記号",
  "記号,一般",
  "記号,読点",
  "記号,句点",
  "記号,空白",
  "記号,括弧閉",
  "その他,間投",
  "フィラー",
  "非言語音"
]
[[token_filters]]
kind = "japanese_katakana_stem"
  [token_filters.args]
  min = 3
[[token_filters]]
kind = "remove_diacritical_mark"
  [token_filters.args]
  japanese = false
$$);

statement ok
SELECT tokenizer_catalog.create_tokenizer('lindera_ipadic', $$
model = "lindera_ipadic"
$$);

query T
SELECT tokenizer_catalog.tokenize('関西国際空港限定トートバッグ', 'lindera_ipadic');
----
{372982,374178}

query T
SELECT tokenizer_catalog.tokenize('東京スカイツリーの最寄り駅はとうきょうスカイツリー駅です', 'lindera_ipadic');
----
{250026,89250,91811,245238,47806,21421,89250,91811,383794}

statement ok
SELECT tokenizer_catalog.drop_lindera_model('lindera_ipadic');

# Catalog JSON created before the Lindera 6 upgrade must still load.
statement ok
INSERT INTO tokenizer_catalog.model (name, config) VALUES
('lindera_legacy', '{"lindera":{"segmenter":{"mode":"normal","dictionary":{"kind":"ipadic"}}}}');

statement ok
SELECT tokenizer_catalog.create_tokenizer('lindera_legacy', $$
model = "lindera_legacy"
$$);

query T
SELECT tokenizer_catalog.tokenize('関西国際空港限定トートバッグ', 'lindera_legacy');
----
{372982,374178}

# Lindera 6 unknown-word IDs are lexicon-local numbers, not u32::MAX.
query T
SELECT tokenizer_catalog.tokenize('トートバッグ', 'lindera_legacy');
----
{}

statement ok
SELECT tokenizer_catalog.drop_tokenizer('lindera_legacy');

statement ok
SELECT tokenizer_catalog.drop_lindera_model('lindera_legacy');
